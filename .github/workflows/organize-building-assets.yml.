
name: Organize Building Assets

on:
  workflow_dispatch:
    inputs:
      zip_path:
        description: "ZIP file in repository root"
        required: true
        default: "fidoria_buildings.zip"

permissions:
  contents: write

jobs:
  organize:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Prepare folders and extract assets
        shell: bash
        env:
          ZIP_PATH: ${{ inputs.zip_path }}
        run: |
          set -euo pipefail

          if [ ! -f "$ZIP_PATH" ]; then
            echo "ERROR: ZIP not found: $ZIP_PATH"
            exit 1
          fi

          TEMP_DIR="$RUNNER_TEMP/fidoria-buildings"
          mkdir -p "$TEMP_DIR"

          unzip -j "$ZIP_PATH" \
            'fidoria_buildings/*.png' \
            -d "$TEMP_DIR"

          mkdir -p \
            Buildings/Village \
            Buildings/Military \
            Buildings/Services \
            Buildings/Guild-and-Magic \
            Buildings/Workshops \
            Whispering-Forest/Dungeon

      - name: Organize assets by category
        shell: bash
        run: |
          set -euo pipefail

          SRC="$RUNNER_TEMP/fidoria-buildings"

          move_asset() {
            local file="$1"
            local destination="$2"

            if [ ! -f "$SRC/$file" ]; then
              echo "ERROR: Missing asset: $file"
              exit 1
            fi

            cp "$SRC/$file" "$destination/"
            echo "Organized: $file -> $destination"
          }

          # Village
          move_asset castle.png Buildings/Village
          move_asset town_hall.png Buildings/Village
          move_asset house_red_roof.png Buildings/Village
          move_asset market_stalls.png Buildings/Village
          move_asset potion_fruit_stall.png Buildings/Village
          move_asset tavern_inn.png Buildings/Village
          move_asset windmill.png Buildings/Village
          move_asset church.png Buildings/Village

          # Military
          move_asset barracks_castle.png Buildings/Military

          # Services
          move_asset clinic_hospital.png Buildings/Services
          move_asset herbalist_house.png Buildings/Services

          # Guild and Magic
          move_asset guild_hall.png Buildings/Guild-and-Magic
          move_asset mage_academy.png Buildings/Guild-and-Magic

          # Workshops
          move_asset blacksmith.png Buildings/Workshops

          # Whispering Forest - Dungeon
          move_asset dungeon_portal.png Whispering-Forest/Dungeon

      - name: Remove Unsorted Legacy
        run: |
          rm -rf Outdoor-decoration/Unsorted-Legacy

      - name: Commit organized assets
        shell: bash
        run: |
          set -euo pipefail

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add -A

          if git diff --cached --quiet; then
            echo "No changes to commit."
            exit 0
          fi

          git commit -m "Organize building assets into categories"
          git push
